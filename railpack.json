{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "20",
    "python": "3.11"
  },
  "steps": {
    "build": {
      "inputs": [
        {
          "local": true,
          "include": ["."]
        }
      ],
      "commands": [
        "cd frontend && npm ci && npm run build && cd ../backend && python -m pip install --no-cache-dir -r requirements.txt"
      ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "packages:mise",
        "include": ["/mise/shims", "/mise/installs"]
      },
      {
        "step": "build",
        "include": ["."]
      }
    ],
    "paths": ["/mise/shims"],
    "startCommand": "cd backend && python -m uvicorn app:app --host 0.0.0.0 --port $PORT"
  }
}
